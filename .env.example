# =====================================================================
# Plantilla de variables de entorno
# =====================================================================
# 1. Copie este archivo con el nombre .env  (cp .env.example .env)
# 2. Reemplace TODOS los valores «cambie-…» por los suyos.
# El archivo .env está en .gitignore: NUNCA lo suba al repositorio.

# --- MySQL --------------------------------------------------------------
DB_NAME=sanfelipe
# Usuario de la aplicación (no use root).
DB_USER=sanfelipe
DB_PASSWORD=cambie-esta-contrasena
# Solo para docker compose: contraseña de root del contenedor MySQL.
MYSQL_ROOT_PASSWORD=cambie-esta-contrasena-root

# --- Servidor -------------------------------------------------------------
# Clave de firma de los tokens de acceso (HS256), al menos 32 caracteres.
# Genérela con:  openssl rand -base64 48
JWT_SECRETO=cambie-esta-clave-por-una-aleatoria-de-48-bytes
# Duración del token de acceso (minutos) y del token de actualización (días).
JWT_MINUTOS=15
REFRESH_DIAS=7
# Atributo Secure de la cookie del token de actualización. Déjelo en true con
# HTTPS o en http://localhost; solo con HTTP en la red local póngalo en false.
COOKIE_SEGURA=true
# Orígenes del navegador admitidos por CORS (separados por coma). Con el
# cliente servido por nginx en el mismo origen no hace falta otro.
CORS_ORIGENES=http://localhost:3000
# Hora local de la empresa respecto de UTC, en minutos (Perú: -300).
DESFASE_HORARIO_MIN=-300

# --- Puertos publicados en 127.0.0.1 ------------------------------------
PUERTO_MYSQL=3306
PUERTO_SERVIDOR=8080
PUERTO_CLIENTE=3000

# --- Solo para ejecutar el servidor fuera de Docker (dart run) ----------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_TLS=true
# PUERTO=8080
# PARAMETROS_ARCHIVO=../config/parametros.yaml

# --- Pruebas de aceptación del servidor (base <DB_NAME>_pruebas) -------
# PRUEBAS_DB_HOST=127.0.0.1
# PRUEBAS_DB_PORT=3306
# PRUEBAS_DB_NAME=sanfelipe_pruebas
# PRUEBAS_DB_USER=sanfelipe
# PRUEBAS_DB_PASSWORD=   (por defecto se usa DB_PASSWORD)
