# =====================================================================
# Plantilla de variables de entorno
# =====================================================================
# 1. Copie este archivo con el nombre .env  (cp .env.example .env)
# 2. Reemplace los valores de ejemplo por los suyos.
# El archivo .env está en .gitignore: NUNCA lo suba al repositorio.

# --- Conexión de la aplicación a MySQL --------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=san_felipe
# Usuario de la aplicación (no use root).
DB_USER=san_felipe_app
DB_PASSWORD=cambie_esta_contrasena

# --- Solo para docker compose ------------------------------------------
# Contraseña del usuario root del contenedor MySQL.
MYSQL_ROOT_PASSWORD=cambie_esta_contrasena_root
